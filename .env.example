# Optional cloud sync. Copy to `.env.local` and fill in to enable accounts and cross-device
# progress. Left as-is, the app runs fully offline and never constructs a Supabase client.
#
# Only ever put the PUBLISHABLE key here. It is shipped inside the app bundle and is safe there:
# it carries no authority of its own, and every table it can reach is protected by row level
# security. The service-role key must never appear in this file or in the app.
#
# For the local stack, `npx supabase start` prints the URL and keys to use. Note that an Android
# emulator cannot reach the host's `127.0.0.1`; use `http://10.0.2.2:54321` instead.
EXPO_PUBLIC_SUPABASE_ENABLED=false
EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_do_not_use
