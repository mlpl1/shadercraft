# The bundled course is generated by `npm run content:build`, which always writes
# LF, and `npm run content:check` compares the generated text against this file
# byte for byte. Without this, a checkout with core.autocrlf=true rewrites it
# with CRLF and the check fails on a clean tree. Keep the authored curriculum on
# LF too so the inputs and the generated output stay consistent.
assets/course/bundled-course.json text eol=lf
content/*.json                    text eol=lf
